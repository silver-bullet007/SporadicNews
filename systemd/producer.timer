[Unit]
Description=Sporadic News Producer Timer - Run every 2 hours
Requires=producer.service

[Timer]
# Run every 2 hours (adjust as needed)
OnCalendar=*-*-* 00/2:00:00
# Run 5 minutes after boot if missed
OnBootSec=5min
# Run 5 minutes after last activation if missed
OnUnitActiveSec=2h
Persistent=true

[Install]
WantedBy=timers.target
